# MongoDB (Docker: mongodb://localhost:27017/node-app)
MONGODB_URI=mongodb://localhost:27017/node-app

# Session
SESSION_SECRET=your_session_secret_here

# Mail - MailHog (Docker SMTP: localhost:1025, Web UI: http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@node-app.local
